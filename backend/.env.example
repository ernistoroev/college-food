# Скопируйте в .env для локальной разработки: Copy-Item .env.example .env
DJANGO_DEBUG=True
# Адреса React dev-сервера (Vite), которым разрешено обращаться к API
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# В продакшене задать обязательно (см. DEPLOY.md), DJANGO_DEBUG при этом — False:
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
